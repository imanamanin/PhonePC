<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.PcPhone.Display" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">@dimen/pc_text_display</item>
        <item name="android:textColor">@color/pcphone_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.PcPhone.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">@dimen/pc_text_headline</item>
        <item name="android:textColor">@color/pcphone_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.PcPhone.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">@dimen/pc_text_title</item>
        <item name="android:textColor">@color/pcphone_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.PcPhone.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">@dimen/pc_text_body</item>
        <item name="android:textColor">@color/pcphone_text_muted</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="TextAppearance.PcPhone.Label" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/pc_text_label</item>
        <item name="android:textColor">@color/pcphone_turquoise</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.PcPhone.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/pc_text_caption</item>
        <item name="android:textColor">@color/pcphone_text_muted</item>
    </style>

    <style name="Widget.PcPhone.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/pc_button_height</item>
        <item name="android:minWidth">@dimen/pc_touch_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="cornerRadius">@dimen/pc_radius_md</item>
        <item name="rippleColor">@color/pcphone_ripple</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@animator/pc_button_press</item>
    </style>

    <style name="Widget.PcPhone.Button.Primary">
        <item name="backgroundTint">@color/pcphone_orange</item>
        <item name="android:textColor">@color/pcphone_navy</item>
        <item name="rippleColor">@color/pcphone_ripple_orange</item>
        <item name="iconTint">@color/pcphone_navy</item>
        <item name="iconPadding">10dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.PcPhone.Button.Secondary">
        <item name="backgroundTint">@color/pcphone_surface_high</item>
        <item name="android:textColor">@color/pcphone_text</item>
        <item name="strokeColor">@color/pcphone_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconTint">@color/pcphone_turquoise</item>
        <item name="iconPadding">10dp</item>
    </style>

    <style name="Widget.PcPhone.Button.Ghost" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/pc_button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/pc_radius_md</item>
        <item name="strokeColor">@color/pcphone_stroke</item>
        <item name="android:textColor">@color/pcphone_text_muted</item>
        <item name="rippleColor">@color/pcphone_ripple</item>
        <item name="iconTint">@color/pcphone_text_muted</item>
        <item name="android:stateListAnimator">@animator/pc_button_press</item>
    </style>

    <style name="Widget.PcPhone.Chip" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/pc_chip_height</item>
        <item name="android:minWidth">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="cornerRadius">@dimen/pc_radius_sm</item>
        <item name="strokeColor">@color/pcphone_stroke</item>
        <item name="android:textColor">@color/pc_lang_text</item>
        <item name="backgroundTint">@color/pc_lang_bg</item>
        <item name="rippleColor">@color/pcphone_ripple</item>
    </style>

    <style name="Widget.PcPhone.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/pcphone_surface</item>
        <item name="cardCornerRadius">@dimen/pc_radius_card</item>
        <item name="cardElevation">@dimen/pc_elevation_card</item>
        <item name="strokeColor">@color/pcphone_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/pcphone_ripple</item>
    </style>
</resources>
