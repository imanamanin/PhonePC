<Window x:Class="PhoneControl.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PhoneControl.Desktop.Controls"
        Title="Phone Control Suite"
        Height="720"
        Width="1100"
        MinHeight="480"
        MinWidth="800"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom" Background="#FF1B1E27" Foreground="{StaticResource TextBrush}">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusBarText}"/>
            </StatusBarItem>
        </StatusBar>

        <DockPanel Margin="16">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="Phone Control Suite" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding PhaseLabel}" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding Notice}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="Connect" Command="{Binding ConnectCommand}" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Padding="12,6" Margin="0,0,8,0"/>
                <TextBox Width="90" Margin="0,0,8,0" VerticalContentAlignment="Center"
                         Text="{Binding PinText, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="6"
                         ToolTip="6-digit PIN shown on the phone"/>
                <Button Content="Pair" Command="{Binding PairCommand}" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="Unpair" Command="{Binding UnpairCommand}" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="Back" Command="{Binding BackCommand}" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="Home" Command="{Binding HomeCommand}" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="Recents" Command="{Binding RecentsCommand}" Padding="12,6"/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="4">
                    <controls:PhoneSurface x:Name="PhoneView"/>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Device" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding ConnectionStateText}"/>
                            <TextBlock Text="{Binding DeviceText}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding TetheringText}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding AdbText}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding DiscoveredText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding EndpointText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding BatteryText}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding SasText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Permissions" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding PermissionsText}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Stream" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="Video on TCP 17891. Input on TCP 17890. MediaProjection never starts without the system dialog."
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
